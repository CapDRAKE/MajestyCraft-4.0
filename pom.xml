<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.majestycraft</groupId>
    <artifactId>majestycraft-launcher</artifactId>
    <version>4.0</version>
    <packaging>jar</packaging>
    <name>MajestyCraft-Launcher</name>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <dependency>
            <groupId>fr.trxyy.alternative</groupId>
            <artifactId>alternative-api</artifactId>
            <version>1.7.0</version>
        </dependency>

        <!-- JavaFX : fourni par le Java qui lance le launcher (Zulu 8 FX installé par le
             setup, JDK 8 en développement), jamais embarqué dans le jar. Les classes de
             lib/ext passent avant celles du jar : la copie embarquée ne servait pas. -->
		<dependency>
    		<groupId>com.oracle</groupId>
    		<artifactId>javafx</artifactId>
    		<version>2.2</version>
    		<scope>provided</scope>
		</dependency>

        <!-- Discord RPC - installé manuellement dans .m2 -->
        <dependency>
            <groupId>com.jagrosh</groupId>
            <artifactId>java-discord-rpc</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- AnimateFX : sans OpenJFX 17 (Windows et Linux), qu'il tire par défaut. Ses
             natives (dont 57 Mo de WebKit) n'étaient jamais chargées par JavaFX 8. -->
        <dependency>
            <groupId>io.github.typhon0</groupId>
            <artifactId>AnimateFX</artifactId>
            <version>1.2.2</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- JFoenix -->
        <dependency>
            <groupId>com.jfoenix</groupId>
            <artifactId>jfoenix</artifactId>
            <version>8.0.10</version>
        </dependency>
        
        <!-- Lecture des icônes WebP (Modrinth) via ImageIO. Décodeur écrit en Java : l'ancien
             (org.sejda webp-imageio 0.1.6) embarquait une libwebp native de 2020, touchée par la
             faille CVE-2023-4863. Rendu identique au pixel près sur les icônes Modrinth. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.15.3</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>MajestyCraft</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- logging.properties et resources/messages_*.properties vivent ici -->
                <directory>src/main/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- Shade plugin : produit un fat JAR avec tout dedans -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- JNA ne sert qu'à Discord RPC, dont la bibliothèque native n'existe
                                     que pour Windows, Linux x86-64 et macOS : ailleurs, Discord RPC est
                                     désactivé dans tous les cas. Natives JNA des autres plateformes retirées. -->
                                <filter>
                                    <artifact>com.jagrosh:java-discord-rpc</artifact>
                                    <excludes>
                                        <exclude>com/sun/jna/aix-*/**</exclude>
                                        <exclude>com/sun/jna/sunos-*/**</exclude>
                                        <exclude>com/sun/jna/linux-ppc*/**</exclude>
                                        <exclude>com/sun/jna/linux-arm*/**</exclude>
                                        <exclude>com/sun/jna/linux-aarch64/**</exclude>
                                        <exclude>com/sun/jna/linux-x86/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- Seul le lecteur WebP sert : les flux d'images de TwelveMonkeys
                                     remplaceraient ceux de Java pour toutes les images (PNG compris). -->
                                <filter>
                                    <artifact>com.twelvemonkeys.imageio:imageio-core</artifact>
                                    <excludes>
                                        <exclude>META-INF/services/javax.imageio.spi.ImageInputStreamSpi</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fr.majestycraft.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>